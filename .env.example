# Скопируйте этот файл в .env и заполните. Файл .env никогда не попадает в GitHub.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш Telegram ID: Марта отвечает только этому аккаунту
OWNER_ID=601067607

# Ключ авторизации GigaChat API (developers.sber.ru → проект GigaChat API → «Получить ключ»)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2 (быстрее и дешевле), GigaChat-2-Pro или GigaChat-2-Max (умнее)
GIGACHAT_MODEL=GigaChat-2

# Модель распознавания речи: base (меньше памяти) или small (точнее)
WHISPER_MODEL=small
# Если модель не скачивается с Hugging Face, раскомментируйте зеркало:
# HF_ENDPOINT=https://hf-mirror.com

TIMEZONE=Europe/Moscow
MORNING_AT=09:00
EVENING_AT=23:00
# Через сколько дней удалять выполненное и прошедшее
KEEP_DAYS=30

# Мини-приложение в Telegram: 1 — включено, 0 — выключено (бот работает и без него)
WEBAPP_ENABLED=0
WEBAPP_URL=https://marta.ostepanovva.ru
